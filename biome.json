{
    "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
    "files": {
        "includes": [
            "**",
            "!!dist",
            "!!test/fixtures/astro-build/src/content/**/*.md"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended"
        }
    }
}
